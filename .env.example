# ── Database ──
# Used by docker-compose.prod.yml (individual vars) and backend (DATABASE_URL)
POSTGRES_USER=aee_user
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=aee_db
DATABASE_URL=postgresql://aee_user:change-me-to-a-strong-password@localhost:5432/aee_db

# ── Auth ──
JWT_SECRET=change-me-to-a-random-64-char-string

# ── LLM (priority: DeepSeek → OpenAI → Local) ──
# DeepSeek API (cheapest, OpenAI-compatible)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# Direct OpenAI (used if DEEPSEEK_API_KEY is not set)
OPENAI_API_KEY=sk-your-openai-key-here
# Model name — interpreted by whichever provider is active
# DeepSeek: deepseek-chat, deepseek-reasoner
# OpenAI: gpt-4o-mini, gpt-4o
LLM_MODEL=deepseek-chat
# Local GGUF fallback (used if no API keys are set)
# LOCAL_MODEL_PATH=/path/to/model.gguf

# ── App ──
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
# Set this for the frontend container (used at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Email (optional — logs to console if not set) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=AEE <noreply@yourdomain.com>

# ── Rate Limiting ──
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LLM_THROTTLE_TTL=60
LLM_THROTTLE_LIMIT=20
