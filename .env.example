# ── Database ──
# Toggle database backend:
# - true: use external RDS PostgreSQL via DATABASE_URL
# - false: use local postgres sidecar in docker-compose.localdb.yml
USE_RDS=false

# Used when USE_RDS=false
POSTGRES_USER=aee_user
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=aee_db

# Used when USE_RDS=true
DATABASE_URL=postgresql://aee_user:change-me-to-a-strong-password@your-rds-endpoint:5432/aee_db?schema=public&sslmode=require

# ── Deploy Sync (optional) ──
# deploy.sh can rebuild .env from this template and then overlay real values from AWS.
# AEE_ENV_SECRET_ID=aee/prod/app-env
# AEE_ENV_SSM_PATH=/aee/prod/

# ── Authentication (ALB-managed) ──
# Cognito configuration is defined on the ALB authenticate-cognito action.
# Backend trusts ALB identity headers (x-amzn-oidc-identity / x-amzn-oidc-data).
# Keep backend private and reachable only via ALB security groups.

# ── LLM (default priority: Bedrock → DeepSeek → OpenAI → Local) ──
# Optional explicit provider override: bedrock, deepseek, openai, local, auto
LLM_PROVIDER=bedrock
# AWS Bedrock Runtime (default remote provider)
# Uses the standard AWS SDK credential chain: env vars, shared profile, ECS/EC2 role, etc.
AWS_REGION=ap-northeast-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# DeepSeek API fallback (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# Direct OpenAI fallback
OPENAI_API_KEY=sk-your-openai-key-here
# Model name for DeepSeek/OpenAI when those providers are active
# DeepSeek: deepseek-chat, deepseek-reasoner
# OpenAI: gpt-4o-mini, gpt-4o
LLM_MODEL=deepseek-chat
# Local GGUF fallback (used if no remote provider is configured)
# LOCAL_MODEL_PATH=/path/to/model.gguf

# ── Error Logging (optional) ──
# Set ERROR_LOG_S3_BUCKET to enable backend exception logging to S3.
# Uses standard AWS SDK credentials and region resolution.
ERROR_LOG_S3_BUCKET=
ERROR_LOG_S3_PREFIX=errors
# Optional region override (defaults to AWS_REGION/AWS_DEFAULT_REGION)
# ERROR_LOG_S3_REGION=ap-northeast-1

# ── App ──
BACKEND_PORT=4000
# Must be your public URL in production, e.g. https://app.example.com
FRONTEND_URL=http://localhost:3000
# Local dev can use http://localhost:4000. Leave blank in production when ALB routes /api to backend.
NEXT_PUBLIC_API_URL=

# ── Rate Limiting ──
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LLM_THROTTLE_TTL=60
LLM_THROTTLE_LIMIT=20
